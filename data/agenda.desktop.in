[Desktop Entry]
Type=Application
Name=Agenda
Name[fr]=Agenda
GenericName=Calendar
GenericName[fr]=Agenda
Comment=Your iCloud calendars and the ones on this PC
Comment[fr]=Vos agendas iCloud et ceux de ce PC
Exec=@BINDIR@/@APP_ID@ %U
Icon=@APP_ID@
Terminal=false
Categories=Office;Calendar;GTK;
Keywords=calendar;agenda;events;iCloud;Covalence;
Keywords[fr]=agenda;calendrier;évènements;rendez-vous;iCloud;Covalence;
MimeType=text/calendar;
StartupNotify=true
